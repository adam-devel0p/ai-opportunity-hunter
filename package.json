{
  "name": "ai-opportunity-hunter",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit false --outDir dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "spike:research": "tsx scripts/spike-research.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db/migrate.ts",
    "campaigns": "tsx scripts/campaigns.ts",
    "discover": "tsx scripts/discover.ts",
    "prescreen": "tsx scripts/prescreen.ts",
    "research": "tsx scripts/research.ts",
    "analyze": "tsx scripts/analyze.ts",
    "verify": "tsx scripts/verify.ts",
    "offer": "tsx scripts/offer.ts",
    "contact": "tsx scripts/contact.ts"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.5.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.10.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
}
