{
  "name": "ai-opportunity-hunter",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "npm run build:worker && npm run build:dashboard",
    "build:worker": "tsc -p tsconfig.backend.json --noEmit false --outDir dist",
    "build:dashboard": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc -p tsconfig.backend.json --noEmit && tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "spike:research": "tsx scripts/spike-research.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db/migrate.ts",
    "campaigns": "tsx scripts/campaigns.ts",
    "discover": "tsx scripts/discover.ts",
    "prescreen": "tsx scripts/prescreen.ts",
    "research": "tsx scripts/research.ts",
    "analyze": "tsx scripts/analyze.ts",
    "verify": "tsx scripts/verify.ts",
    "offer": "tsx scripts/offer.ts",
    "contact": "tsx scripts/contact.ts",
    "outreach": "tsx scripts/outreach.ts",
    "worker": "tsx src/worker.ts",
    "autonomous": "tsx scripts/autonomous.ts"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "next": "^16.3.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
}
